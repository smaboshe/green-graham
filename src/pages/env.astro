---
export const prerender = false;

const publicTestCilantroUrl = import.meta.env.PUBLIC_TEST_CILANTRO_URL || 'not set';
const publicTestOreganoUrl = import.meta.env.PUBLIC_TEST_OREGANO_URL || 'not set';
const secretTestAccountId = import.meta.env.SECRET_TEST_ACCOUNT_ID || 'not set';
const secretTestApiKey = import.meta.env.SECRET_TEST_API_KEY || 'not set';
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Environment Variables</title>
</head>
<body>
  <h1>Environment Variables</h1>

  <ul>
    <li>PUBLIC_TEST_CILANTRO_URL: {publicTestCilantroUrl}</li>
    <li>PUBLIC_TEST_OREGANO_URL: {publicTestOreganoUrl}</li>
    <li>SECRET_TEST_ACCOUNT_ID: {secretTestAccountId}</li>
    <li>SECRET_TEST_API_KEY: {secretTestApiKey}</li>
  </ul>
</body>
</html>
