{
	"main": "dist/_worker.js/index.js",
	"name": "green-graham",
  "compatibility_date": "2025-11-06",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
    "enabled": true
  },
  "vars": {
    "PUBLIC_TEST_CILANTRO_URL": "http://production.api.cilantro.example.com",
  },
  "secrets": [
    "TEST_ACCOUNT_ID",
    "TEST_SECRET_API_KEY"
  ]
}
